DATABASE_URL=postgresql+asyncpg://seenior:seenior@localhost:5432/seenior
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=814522278451-9ueiiue6342vhiak12v3l2eaau5afr6d.apps.googleusercontent.com

# Firebase service-account key, used to send FCM pushes. Accepts EITHER a path to the
# downloaded .json (easiest locally) or the raw JSON itself on one line (what Render
# wants). Unset = pushes disabled; alerts still record and the family app still polls.
#
# NEVER commit the real value. Keep the .json outside the repo.
# Locally:
FIREBASE_CREDENTIALS=C:/Users/tuf/secrets/seenior-fcm-service-account.json
# On Render, paste the file's whole contents instead:
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"seenior",...}

# Semaphore PH SMS fallback, used for both the family tier (alongside push) and the
# barangay tier (its only channel besides the dashboard). Unset = SMS disabled; alerts
# still record and push still goes out where configured. Get a key from
# semaphore.co after signing up; NEVER commit the real value.
SEMAPHORE_API_KEY=your-semaphore-api-key
# Optional. Requires a sender name registered and approved with Semaphore first;
# leave unset to use Semaphore's default sender name.
# SEMAPHORE_SENDER_NAME=SEENior