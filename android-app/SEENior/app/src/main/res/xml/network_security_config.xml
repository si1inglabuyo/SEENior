<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to the emulator's host-loopback alias (10.0.2.2), where the
     dev FastAPI backend runs without TLS. Everything else stays HTTPS-only by default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
