<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar / notification small icon.

    Android draws notification small icons as a flat alpha mask and tints them
    itself, so this is deliberately a single-colour silhouette rather than the
    full-colour SEENior emblem (which would render as an unreadable white blob).
    Simplified to roof + two figures so it still reads at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- roof -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2.15 L22.35,10.45 L20.62,12.6 L12,5.7 L3.38,12.6 L1.65,10.45 Z" />

    <!-- senior: head + shoulders -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.8,12.25 a2.05,2.05 0 1,0 0,4.1 a2.05,2.05 0 1,0 0,-4.1 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.55,21.85 c0,-2.95 1.45,-5.05 3.25,-5.05 c1.8,0 3.25,2.1 3.25,5.05 Z" />

    <!-- companion: head + shoulders -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.95,14.15 a1.6,1.6 0 1,0 0,3.2 a1.6,1.6 0 1,0 0,-3.2 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.35,21.85 c0,-2.35 1.15,-4.05 2.6,-4.05 c1.45,0 2.6,1.7 2.6,4.05 Z" />
</vector>
