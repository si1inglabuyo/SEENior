<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Both, and the pair matters. Coarse alone is silently fuzzed by Android 12+ to a
         ~1-2km grid refreshed hourly, which would make the alert map draw a 150m square around
         a point that was never that accurate - a map claiming more than it knows. Holding fine
         means the rounding to a location cluster is this app's own deliberate act, done in
         Geohash.encode() and citable as such, rather than an OS behaviour nobody can point to.
         The precise fix is never stored: see AlertLocationCapture. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- An alert fires while the app is closed and the phone is in a pocket, which is the
         normal case, not the edge case. Without this held, the foreground/background rules
         refuse a location-typed service any time it starts from a reboot or an FCM nudge, which
         on 2026-09-05 crashed monitoring outright for five hours; proven on hardware the same
         day to be this grant, not the health-only try/catch fallback in
         SensorCollectionService.kt, that actually kept monitoring alive on the retest (that
         fallback fired zero times; see seenior-fgs-location-crash). AlertLocationCapture still
         takes exactly one fix per alert and none at all on an ordinary day, as CLAUDE.md 11
         requires; this line only ever affects whether a background service start is allowed
         to ask, never how often it does.

         NOT requested anywhere in this app. Android requires background location to be granted
         through a Settings trip, not a runtime dialog, and no such flow exists here, so
         declaring it in this manifest grants nothing by itself. On the pilot phone it was
         granted by hand (`adb shell pm grant ... ACCESS_BACKGROUND_LOCATION`) as a debugging
         step. A real senior's phone gets nothing from this line until that grant is repeated
         some other way; until then this device silently falls back to the untested health-only
         path above on every background start. Turning this into a real, repeatable step
         (deployment guide, or an in-app settings-page flow like AlertPermissions' two grants)
         is open and tracked in the project's own next-session backlog, not solved by this
         comment. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Lets the monitoring service keep the "while in use" location grant it already holds
         while no screen is open. NOT background location: what the senior granted is unchanged,
         and the service carrying it is the one whose notification is visible the whole time.
         Without this, Android 14+ refuses every location request a passive alert makes - measured
         2026-09-04, a fall alert refused at 13:04:03.5 and permitted only at 13:04:06.9 once the
         prompt reached the screen. That is why inactivity alerts reached the barangay with no
         pin (CLAUDE.md §11). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Held only for the seconds a server-woken sample takes: without it the handset may
         suspend again mid-sample, the moment FCM's brief allowlist lapses. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets a high-risk alert open the wellness prompt over the lock screen instead of waiting
         behind a banner nobody taps. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Lets an alert start the prompt over whatever is on screen, and is what permits a
         background activity start at all from Android 10 on. The full-screen intent above only
         covers a locked or dark screen; a senior part-way through another app gets a banner
         instead unless this is held. Used for nothing but an open alert. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Required to drive the vibrator directly. The notification channel's own vibration is
         posted by the system on our behalf and needs no permission; a waveform that repeats
         until the alert is answered does. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The escalation deadline must fire at a wall-clock moment even in Doze. Measured on an
         Infinix X6885 (Android 15): with only a WorkManager job, a 60s fall window did not
         escalate at all while the phone was idle, and 10-minute windows ran 25 minutes late.
         USE_EXACT_ALARM is granted on install (no runtime dialog) — this app's core function is
         a timed emergency response, which is the category it exists for. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Asked once during onboarding. Exact alarms survive Doze, but OEM skins (XOS, MIUI,
         EMUI) layer their own killers on top of stock Android, and the exemption is the only
         defence against those. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />


    <application
        android:name=".SeniorApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SEENior">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SEENior"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".sensors.SensorCollectionService"
            android:exported="false"
            android:foregroundServiceType="health|location"
        />
        <!-- The reboot recovery net. BIND_JOB_SERVICE is required by the platform and is
             what stops anything but JobScheduler from starting it. -->
        <service
            android:name=".sensors.MonitoringWatchdogJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".sensors.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Wakes the device when an alert's response window expires. Not exported: only
             AlarmManager, delivering our own PendingIntent, ever triggers it. -->
        <receiver
            android:name=".alerts.EscalationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.pup.seenior.action.ESCALATE" />
            </intent-filter>
        </receiver>
        <!-- Receives alerts pushed to a family contact. exported=false is correct even
             though the system starts it: FCM delivers through Google Play services, which
             is granted access by the intent filter, not by the service being public. -->
        <service
            android:name=".alerts.SeeniorMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Icon and colour Android applies to a notification FCM renders itself. Ours are
             all data-only, so this is belt-and-braces: it stops a future notification-payload
             push from falling back to the grey default app icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_seenior" />

        <!-- DEBUG-ONLY. Backs DatabaseExporter's "Export Database" button on Home. Delete this
             entire <provider> block, res/xml/file_paths.xml, DatabaseExporter.kt, and the button
             itself before shipping to a real senior's phone. exported=false + grantUriPermissions
             is the standard FileProvider pairing: nothing outside this app can query it directly,
             and the one URI handed to the share sheet's chosen app is scoped to that grant alone. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>